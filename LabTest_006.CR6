    FieldCal(0, L_3, CReps_L_3, 0, COff_L_3, ZMode_L_3, 0, CIndex_L_3, CAvg_L_3)
    FieldCal(2, L_3, 1, CMult_L_3, COff_L_3, MOMode_L_3, CKnown_L_3, CIndex_L_3, CAvg_L_3)





    '--- CR6 half bridges (string pot / LVDT): 4 sensor(s), signals U8-U11, shared excit U12 ---
    'Grouped BrHalf (Reps=4) -> HalfBr(); elements aliased to names
    BrHalf(HalfBr(), 4, mV200, U8, U12, 4, 2500, True, 500, 500, CMult_2(), COff_2())
    FieldCal(0, SP_1, CReps_SP_1, 0, COff_SP_1, ZMode_SP_1, 0, CIndex_SP_1, CAvg_SP_1)
    FieldCal(2, SP_1, 1, CMult_SP_1, COff_SP_1, MOMode_SP_1, CKnown_SP_1, CIndex_SP_1, CAvg_SP_1)
    FieldCal(0, SP_2, CReps_SP_2, 0, COff_SP_2, ZMode_SP_2, 0, CIndex_SP_2, CAvg_SP_2)
    FieldCal(2, SP_2, 1, CMult_SP_2, COff_SP_2, MOMode_SP_2, CKnown_SP_2, CIndex_SP_2, CAvg_SP_2)
    FieldCal(0, SP_3, CReps_SP_3, 0, COff_SP_3, ZMode_SP_3, 0, CIndex_SP_3, CAvg_SP_3)
    FieldCal(2, SP_3, 1, CMult_SP_3, COff_SP_3, MOMode_SP_3, CKnown_SP_3, CIndex_SP_3, CAvg_SP_3)
    FieldCal(0, SP_4, CReps_SP_4, 0, COff_SP_4, ZMode_SP_4, 0, CIndex_SP_4, CAvg_SP_4)
    FieldCal(2, SP_4, 1, CMult_SP_4, COff_SP_4, MOMode_SP_4, CKnown_SP_4, CIndex_SP_4, CAvg_SP_4)


    '--- CDM-A116 #1 measurements ---
    CDM_Battery(CDM_A116, 1, CDM1BattV)
    CDM_PanelTemp(CDM_A116, 1, CDM1PanelTemp, 1, 1, 60)
    '--- CDM-A116 #1 half bridges (string pot / LVDT): 11 sensor(s), CH1-11, excit EX1 ---
    'Grouped CDM_BrHalf (Reps=11) -> HalfBr_2(); elements aliased to names
    CDM_BrHalf(CDM_A116, 1, HalfBr_2(), 11, mV200, 1, 1, 1, 2500, True, 500, 60, CMult_3(), COff_3())
    FieldCal(0, SP_5, CReps_SP_5, 0, COff_SP_5, ZMode_SP_5, 0, CIndex_SP_5, CAvg_SP_5)
    FieldCal(2, SP_5, 1, CMult_SP_5, COff_SP_5, MOMode_SP_5, CKnown_SP_5, CIndex_SP_5, CAvg_SP_5)
    FieldCal(0, SP_6, CReps_SP_6, 0, COff_SP_6, ZMode_SP_6, 0, CIndex_SP_6, CAvg_SP_6)
    FieldCal(2, SP_6, 1, CMult_SP_6, COff_SP_6, MOMode_SP_6, CKnown_SP_6, CIndex_SP_6, CAvg_SP_6)
    FieldCal(0, SP_7, CReps_SP_7, 0, COff_SP_7, ZMode_SP_7, 0, CIndex_SP_7, CAvg_SP_7)
    FieldCal(2, SP_7, 1, CMult_SP_7, COff_SP_7, MOMode_SP_7, CKnown_SP_7, CIndex_SP_7, CAvg_SP_7)
    FieldCal(0, D_1, CReps_D_1, 0, COff_D_1, ZMode_D_1, 0, CIndex_D_1, CAvg_D_1)
    FieldCal(2, D_1, 1, CMult_D_1, COff_D_1, MOMode_D_1, CKnown_D_1, CIndex_D_1, CAvg_D_1)
    FieldCal(0, D_2, CReps_D_2, 0, COff_D_2, ZMode_D_2, 0, CIndex_D_2, CAvg_D_2)
    FieldCal(2, D_2, 1, CMult_D_2, COff_D_2, MOMode_D_2, CKnown_D_2, CIndex_D_2, CAvg_D_2)
    FieldCal(0, D_3, CReps_D_3, 0, COff_D_3, ZMode_D_3, 0, CIndex_D_3, CAvg_D_3)
    FieldCal(2, D_3, 1, CMult_D_3, COff_D_3, MOMode_D_3, CKnown_D_3, CIndex_D_3, CAvg_D_3)
    FieldCal(0, D_4, CReps_D_4, 0, COff_D_4, ZMode_D_4, 0, CIndex_D_4, CAvg_D_4)
    FieldCal(2, D_4, 1, CMult_D_4, COff_D_4, MOMode_D_4, CKnown_D_4, CIndex_D_4, CAvg_D_4)
    FieldCal(0, D_5, CReps_D_5, 0, COff_D_5, ZMode_D_5, 0, CIndex_D_5, CAvg_D_5)
    FieldCal(2, D_5, 1, CMult_D_5, COff_D_5, MOMode_D_5, CKnown_D_5, CIndex_D_5, CAvg_D_5)
    FieldCal(0, D_6, CReps_D_6, 0, COff_D_6, ZMode_D_6, 0, CIndex_D_6, CAvg_D_6)
    FieldCal(2, D_6, 1, CMult_D_6, COff_D_6, MOMode_D_6, CKnown_D_6, CIndex_D_6, CAvg_D_6)
    FieldCal(0, D_7, CReps_D_7, 0, COff_D_7, ZMode_D_7, 0, CIndex_D_7, CAvg_D_7)
    FieldCal(2, D_7, 1, CMult_D_7, COff_D_7, MOMode_D_7, CKnown_D_7, CIndex_D_7, CAvg_D_7)
    FieldCal(0, D_8, CReps_D_8, 0, COff_D_8, ZMode_D_8, 0, CIndex_D_8, CAvg_D_8)
    FieldCal(2, D_8, 1, CMult_D_8, COff_D_8, MOMode_D_8, CKnown_D_8, CIndex_D_8, CAvg_D_8)

    '--- Strain gauges (Qtr-bridge) CDM-A116 #1: 4 gauge(s), CH12-15, GF from GFAdj_1() ---
    'Grouped CDM_BrFull (Reps=4) -> Vr1000(); StrainCalc -> Strain() [microstrain]
    CDM_BrFull(CDM_A116, 1, Vr1000(), 4, mV200, 12, 1, 1, 2500, True, True, 500, 15000, 1, 0)
    StrainCalc(Strain(), 4, Vr1000(), BrZero_1(), -1, GFAdj_1(), 0)


    '*** Burst trigger channel '' not found - BurstTrig will never fire ***

    CallTable CalHist
    CallTable Normal
    CallTable Burst
  NextScan

EndProg
